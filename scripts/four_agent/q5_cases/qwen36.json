{
  "schema": "hf2q.q5.calibration-case.v1",
  "family": "qwen36",
  "notes": [
    "Derived from: Qwen3.6 runner: current-hf normal baseline and largest-tool-result supervisors; launcher text-only, 48 GiB shared KV budget.",
    "Override any variable with HF2Q_Q5_<NAME>; null variables are required. See scripts/four_agent/README.md.",
    "The client is the checked-in canonical four-agent coding workload. Q5 requires the largest declared workload: if the operator declares a larger one (e.g. largest prompt or tool result), copy this case and replace client.argv.",
    "Release-gate default arm (ADR-067 D6): the case passes no HF2Q_* route switch and the target is the qualified vanilla artifact, so the server's `DFlash2 policy resolved` INFO line must report policy=auto selected=true with every profile switch sourced `profile`. HF2Q_Q5_DFLASH2=0 is the kill-switch control arm (prior promoted route; policy=off selected=false). HF2Q_Q5_HF_HUB_CACHE and HF2Q_Q5_HF_HUB_OFFLINE=1 point the drafter lookup at another Hugging Face cache and forbid the download: with an empty cache the server must log the drafter WARN line and pass on the prior route. Empty values are not exported.",
    "Route binding (ADR-067 D6): HF2Q_Q5_DFLASH2_POLICY (auto|off|required), HF2Q_Q5_DFLASH2_DESCRIPTOR (a pinned descriptor id) and HF2Q_Q5_DFLASH2_QUALIFICATION (pinned_pair|same_shapes) are readiness checks against measurement_snapshot.active_controls.dflash2 of /hf2q/v1/runtime, skipped when empty (a binary before the field publishes none). The release-gate default arm sets all three; the kill-switch arm sets HF2Q_Q5_DFLASH2=0 and HF2Q_Q5_DFLASH2_POLICY=off. The recorded runtime document carries every switch's resolved value and source."
  ],
  "workload": {
    "id": "adr063-q5-qwen36-n4-coding-ctx262144",
    "slots": 4,
    "context_per_slot": 262144,
    "client": "scripts/four_agent/qwen_n4_live_smoke.py --family qwen"
  },
  "variables": {
    "HF2Q_BIN": "{REPO}/target/release/hf2q",
    "MODEL": "{REPO}/models/qwen36-stock-adr063/Qwen3.6-35B-A3B-vanilla-Q4_K_M.gguf",
    "MODEL_SHA256": "",
    "MODEL_ID": "Qwen3.6 35B A3B",
    "PORT": "18236",
    "CARGO": null,
    "TOOLCHAIN": null,
    "SANDBOX_PROOF": null,
    "SANDBOX_PROOF_SHA256": null,
    "CLIENT_APPROVAL_TEMPLATE": null,
    "DFLASH2": "",
    "HF_HUB_CACHE": "",
    "HF_HUB_OFFLINE": "",
    "DFLASH2_POLICY": "",
    "DFLASH2_DESCRIPTOR": "",
    "DFLASH2_QUALIFICATION": ""
  },
  "binary": "{HF2Q_BIN}",
  "artifact": {
    "path": "{MODEL}",
    "sha256": "{MODEL_SHA256}"
  },
  "port": "{PORT}",
  "serve": {
    "argv": [
      "/bin/bash",
      "{REPO}/scripts/serve_qwen36_opencode.sh"
    ],
    "env": {
      "MODEL": "{MODEL}",
      "VISION_MODE": "off",
      "KV_CACHE_BUDGET_BYTES": "51539607552",
      "REP_PENALTY": "1.05",
      "THINKING_TOKEN_BUDGET": "2048",
      "TOOL_THINKING_TOKEN_BUDGET": "512",
      "MAX_SLOTS": "4",
      "HOST": "127.0.0.1",
      "PORT": "{PORT}",
      "HF2Q_BIN": "{HF2Q_BIN}",
      "HF2Q_DFLASH2": "{DFLASH2}",
      "HF_HUB_CACHE": "{HF_HUB_CACHE}",
      "HF_HUB_OFFLINE": "{HF_HUB_OFFLINE}"
    }
  },
  "readiness": {
    "url": "http://127.0.0.1:{PORT}/readyz",
    "field": "ready",
    "equals": true,
    "timeout_seconds": 900,
    "record": [
      "http://127.0.0.1:{PORT}/health",
      "http://127.0.0.1:{PORT}/hf2q/v1/runtime"
    ],
    "checks": [
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "model",
        "equals": "{MODEL_ID}"
      },
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "context_length",
        "equals": 262144
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "serve.max_slots",
        "equals": 4
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.vision_projector",
        "equals": false
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.policy",
        "equals": "{DFLASH2_POLICY}",
        "skip_if_empty": true
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.descriptor",
        "equals": "{DFLASH2_DESCRIPTOR}",
        "skip_if_empty": true
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.qualification",
        "equals": "{DFLASH2_QUALIFICATION}",
        "skip_if_empty": true
      }
    ]
  },
  "client": {
    "argv": [
      "{PYTHON}",
      "-E",
      "-s",
      "-B",
      "{REPO}/scripts/four_agent/qwen_n4_live_smoke.py",
      "--base-url",
      "http://127.0.0.1:{PORT}/v1",
      "--model",
      "{MODEL_ID}",
      "--output",
      "{OUT}/client",
      "--cargo",
      "{CARGO}",
      "--toolchain",
      "{TOOLCHAIN}",
      "--sandbox-exec",
      "/usr/bin/sandbox-exec",
      "--sandbox-proof",
      "{SANDBOX_PROOF}",
      "--sandbox-proof-sha256",
      "{SANDBOX_PROOF_SHA256}",
      "--server-pid",
      "{SERVER_PID}",
      "--approval",
      "{CLIENT_APPROVAL}",
      "--approval-sha256",
      "{CLIENT_APPROVAL_SHA256}",
      "--family",
      "qwen",
      "--engine-kind",
      "hf2q"
    ],
    "env": {},
    "approval": {
      "template": "{CLIENT_APPROVAL_TEMPLATE}",
      "set": {
        "server_pid": "{SERVER_PID}",
        "base_url": "http://127.0.0.1:{PORT}/v1",
        "model": "{MODEL_ID}",
        "run_id": "{RUN_ID}",
        "barrier_token": "{NONCE32}",
        "python_sha256": "{PYTHON_SHA256}",
        "sources": {
          "sha256_of": [
            "{REPO}/scripts/four_agent/qwen38_n1_smoke.py",
            "{REPO}/scripts/four_agent/qwen38_n1_tools.py",
            "{REPO}/scripts/four_agent/qwen38_n1_verdict.py",
            "{REPO}/scripts/four_agent/qwen38_n1_process.py",
            "{REPO}/scripts/four_agent/test_qwen38_n1_verdict.py",
            "{REPO}/scripts/four_agent/qwen_n4_live_smoke.py",
            "{REPO}/scripts/four_agent/test_qwen_n4_live_smoke.py",
            "{REPO}/scripts/four_agent/coding_family.py",
            "{REPO}/scripts/four_agent/test_coding_family.py",
            "{REPO}/scripts/four_agent/qwen_n4_peer.py",
            "{REPO}/scripts/four_agent/test_qwen_n4_peer.py",
            "{REPO}/scripts/four_agent/family_peer.py",
            "{REPO}/scripts/four_agent/test_family_peer.py",
            "{REPO}/scripts/four_agent/f2_semantic.py"
          ]
        }
      }
    },
    "summary": "{OUT}/client/summary.json",
    "success_status": "FourAgentProtocolCompleteAwaitingIndependentReview",
    "timeout_seconds": 7200
  },
  "policy": {}
}
