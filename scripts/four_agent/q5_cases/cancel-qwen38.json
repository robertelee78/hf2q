{
  "schema": "hf2q.q5.calibration-case.v1",
  "family": "qwen38",
  "notes": [
    "ADR-063 S3 S-C1/S-C2 cancel smoke for qwen38: the server launch, readiness and memory supervision of q5_cases/qwen38.json; the client is cancel_smoke.py instead of the four-agent coding protocol.",
    "Override any variable with HF2Q_Q5_<NAME>; null variables are required. See scripts/four_agent/README.md \"S3 cancel smoke\".",
    "The client replays the four recorded agent-N/turn-{TURN}/request.json of RECORDED_CLIENT as concurrent streams, closes agent CANCEL_AGENT's stream after CANCEL_AFTER_EVENTS semantic events while the other three are still decoding, then replays the four requests again without a cancel (control). Its receipt is {OUT}/client/summary.json; success is CancelSmokePass.",
    "RECORDED_CLIENT for the current artifact: $E/q5-qwen38-final-20261030T051303Z/client (CalibrationPass; turn-2 completions 217 tokens each). Its requests must name MODEL_ID.",
    "LOG_FILTER replaces the launcher's -v (under which hf2q ignores RUST_LOG) with RUST_LOG=LOG_FILTER, adding the per-turn joint decode debug lines that the client histograms from {OUT}/server.stderr (S-C2).",
    "No client approval: the client runs no tools, cargo or sandbox; it only talks to the supervised loopback server and reads its log."
  ],
  "workload": {
    "id": "adr063-s3-cancel-smoke-qwen38-n4-ctx262144",
    "slots": 4,
    "context_per_slot": 262144,
    "client": "scripts/four_agent/cancel_smoke.py run --family qwen38"
  },
  "variables": {
    "HF2Q_BIN": "{REPO}/target/release/hf2q",
    "MODEL": "{REPO}/models/qwen38-stock/Qwen3.8-27B-vanilla.gguf",
    "MODEL_SHA256": "",
    "MODEL_ID": "Qwen3.8 27B",
    "PORT": "18238",
    "RECORDED_CLIENT": null,
    "TURN": "2",
    "CANCEL_AGENT": "0",
    "CANCEL_AFTER_EVENTS": "16",
    "LOG_FILTER": "hf2q=info,mlx_native=info,hf2q::serve::api::engine_qwen35::progress=debug"
  },
  "binary": "{HF2Q_BIN}",
  "artifact": {
    "path": "{MODEL}",
    "sha256": "{MODEL_SHA256}",
    "text_only_locator": true
  },
  "port": "{PORT}",
  "serve": {
    "argv": [
      "/bin/bash",
      "{REPO}/scripts/serve_qwen38_opencode.sh"
    ],
    "env": {
      "MODEL": "{SERVED_MODEL}",
      "QWEN38_VISION": "off",
      "KV_CACHE_BUDGET_BYTES": "51539607552",
      "MAX_SLOTS": "4",
      "HOST": "127.0.0.1",
      "PORT": "{PORT}",
      "HF2Q_BIN": "{HF2Q_BIN}",
      "LOG_FILTER": "{LOG_FILTER}"
    }
  },
  "readiness": {
    "url": "http://127.0.0.1:{PORT}/readyz",
    "field": "ready",
    "equals": true,
    "timeout_seconds": 900,
    "record": [
      "http://127.0.0.1:{PORT}/health",
      "http://127.0.0.1:{PORT}/hf2q/v1/runtime"
    ],
    "checks": [
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "model",
        "equals": "{MODEL_ID}"
      },
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "context_length",
        "equals": 262144
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "serve.max_slots",
        "equals": 4
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.vision_projector",
        "equals": false
      }
    ]
  },
  "client": {
    "argv": [
      "{PYTHON}",
      "-E",
      "-s",
      "-B",
      "{REPO}/scripts/four_agent/cancel_smoke.py",
      "run",
      "--base-url",
      "http://127.0.0.1:{PORT}/v1",
      "--model",
      "{MODEL_ID}",
      "--family",
      "qwen38",
      "--requests",
      "{RECORDED_CLIENT}",
      "--turn",
      "{TURN}",
      "--cancel-agent",
      "{CANCEL_AGENT}",
      "--cancel-after-events",
      "{CANCEL_AFTER_EVENTS}",
      "--server-log",
      "{OUT}/server.stderr",
      "--server-pid",
      "{SERVER_PID}",
      "--output",
      "{OUT}/client"
    ],
    "env": {},
    "summary": "{OUT}/client/summary.json",
    "success_status": "CancelSmokePass",
    "timeout_seconds": 3600
  },
  "policy": {}
}
