{
  "schema": "hf2q.q5.calibration-case.v1",
  "family": "qwen36",
  "notes": [
    "hf2q arm of the Qwen3.6 vendor request setup; same GGUF, launcher, slots, context and KV budget as qwen36.json.",
    "Launcher: REP_PENALTY 1.0 and both default thinking budgets disabled (THINKING_TOKEN_BUDGET=0, TOOL_THINKING_TOKEN_BUDGET=0; qwen_thinking_policy.rs QwenThinkingDefaults::from_config maps 0 to no ceiling for tool_choice auto). Readiness requires /hf2q/v1/runtime to report both budgets as 0. hf2q has no server-side temperature default, so the request carries the sampling.",
    "Override any variable with HF2Q_Q5_<NAME>; null variables are required. See scripts/four_agent/README.md.",
    "Vendor request setup (ADR-063 Q4-QWEN36): the client runs --request-setup qwen36-vendor-coding-v1 (request_setup.py) and sends Qwen's 'thinking mode for precise coding tasks' sampling on every request: temperature 0.6, top_p 0.95, top_k 20, min_p 0, presence_penalty 0, repetition penalty 1.0 (Qwen/Qwen3.6-35B-A3B@995ad96e README.md, Best Practices). Thinking stays on, preserve_thinking stays true and every assistant message re-sends its reasoning_content, as in the canonical client. Template, tools, task instances and the strict six-step workflow are unchanged; only sampling and the thinking budget differ.",
    "Derived from qwen36.json; every field not named above is unchanged."
  ],
  "workload": {
    "id": "adr063-q5-qwen36-vendor-n4-coding-ctx262144",
    "slots": 4,
    "context_per_slot": 262144,
    "client": "scripts/four_agent/qwen_n4_live_smoke.py --family qwen --request-setup qwen36-vendor-coding-v1"
  },
  "variables": {
    "HF2Q_BIN": "{REPO}/target/release/hf2q",
    "MODEL": "{REPO}/models/qwen36-stock-adr063/Qwen3.6-35B-A3B-vanilla-Q4_K_M.gguf",
    "MODEL_SHA256": "",
    "MODEL_ID": "Qwen3.6 35B A3B",
    "PORT": "18236",
    "CARGO": null,
    "TOOLCHAIN": null,
    "SANDBOX_PROOF": null,
    "SANDBOX_PROOF_SHA256": null,
    "CLIENT_APPROVAL_TEMPLATE": null,
    "DFLASH2": "",
    "HF_HUB_CACHE": "",
    "HF_HUB_OFFLINE": "",
    "DFLASH2_POLICY": "",
    "DFLASH2_DESCRIPTOR": "",
    "DFLASH2_QUALIFICATION": ""
  },
  "binary": "{HF2Q_BIN}",
  "artifact": {
    "path": "{MODEL}",
    "sha256": "{MODEL_SHA256}"
  },
  "port": "{PORT}",
  "serve": {
    "argv": [
      "/bin/bash",
      "{REPO}/scripts/serve_qwen36_opencode.sh"
    ],
    "env": {
      "MODEL": "{MODEL}",
      "VISION_MODE": "off",
      "KV_CACHE_BUDGET_BYTES": "51539607552",
      "REP_PENALTY": "1.0",
      "THINKING_TOKEN_BUDGET": "0",
      "TOOL_THINKING_TOKEN_BUDGET": "0",
      "MAX_SLOTS": "4",
      "HOST": "127.0.0.1",
      "PORT": "{PORT}",
      "HF2Q_BIN": "{HF2Q_BIN}",
      "HF2Q_DFLASH2": "{DFLASH2}",
      "HF_HUB_CACHE": "{HF_HUB_CACHE}",
      "HF_HUB_OFFLINE": "{HF_HUB_OFFLINE}"
    }
  },
  "readiness": {
    "url": "http://127.0.0.1:{PORT}/readyz",
    "field": "ready",
    "equals": true,
    "timeout_seconds": 900,
    "record": [
      "http://127.0.0.1:{PORT}/health",
      "http://127.0.0.1:{PORT}/hf2q/v1/runtime"
    ],
    "checks": [
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "model",
        "equals": "{MODEL_ID}"
      },
      {
        "url": "http://127.0.0.1:{PORT}/health",
        "field": "context_length",
        "equals": 262144
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "serve.max_slots",
        "equals": 4
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.vision_projector",
        "equals": false
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.sampling_defaults.thinking_token_budget",
        "equals": 0
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.sampling_defaults.tool_thinking_token_budget",
        "equals": 0
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.policy",
        "equals": "{DFLASH2_POLICY}",
        "skip_if_empty": true
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.descriptor",
        "equals": "{DFLASH2_DESCRIPTOR}",
        "skip_if_empty": true
      },
      {
        "url": "http://127.0.0.1:{PORT}/hf2q/v1/runtime",
        "field": "measurement_snapshot.active_controls.dflash2.qualification",
        "equals": "{DFLASH2_QUALIFICATION}",
        "skip_if_empty": true
      }
    ]
  },
  "client": {
    "argv": [
      "{PYTHON}",
      "-E",
      "-s",
      "-B",
      "{REPO}/scripts/four_agent/qwen_n4_live_smoke.py",
      "--base-url",
      "http://127.0.0.1:{PORT}/v1",
      "--model",
      "{MODEL_ID}",
      "--output",
      "{OUT}/client",
      "--cargo",
      "{CARGO}",
      "--toolchain",
      "{TOOLCHAIN}",
      "--sandbox-exec",
      "/usr/bin/sandbox-exec",
      "--sandbox-proof",
      "{SANDBOX_PROOF}",
      "--sandbox-proof-sha256",
      "{SANDBOX_PROOF_SHA256}",
      "--server-pid",
      "{SERVER_PID}",
      "--approval",
      "{CLIENT_APPROVAL}",
      "--approval-sha256",
      "{CLIENT_APPROVAL_SHA256}",
      "--family",
      "qwen",
      "--engine-kind",
      "hf2q",
      "--request-setup",
      "qwen36-vendor-coding-v1"
    ],
    "env": {},
    "approval": {
      "template": "{CLIENT_APPROVAL_TEMPLATE}",
      "set": {
        "server_pid": "{SERVER_PID}",
        "base_url": "http://127.0.0.1:{PORT}/v1",
        "model": "{MODEL_ID}",
        "run_id": "{RUN_ID}",
        "barrier_token": "{NONCE32}",
        "python_sha256": "{PYTHON_SHA256}",
        "sources": {
          "sha256_of": [
            "{REPO}/scripts/four_agent/qwen38_n1_smoke.py",
            "{REPO}/scripts/four_agent/qwen38_n1_tools.py",
            "{REPO}/scripts/four_agent/qwen38_n1_verdict.py",
            "{REPO}/scripts/four_agent/qwen38_n1_process.py",
            "{REPO}/scripts/four_agent/test_qwen38_n1_verdict.py",
            "{REPO}/scripts/four_agent/qwen_n4_live_smoke.py",
            "{REPO}/scripts/four_agent/test_qwen_n4_live_smoke.py",
            "{REPO}/scripts/four_agent/coding_family.py",
            "{REPO}/scripts/four_agent/test_coding_family.py",
            "{REPO}/scripts/four_agent/qwen_n4_peer.py",
            "{REPO}/scripts/four_agent/test_qwen_n4_peer.py",
            "{REPO}/scripts/four_agent/family_peer.py",
            "{REPO}/scripts/four_agent/test_family_peer.py",
            "{REPO}/scripts/four_agent/f2_semantic.py",
            "{REPO}/scripts/four_agent/request_setup.py",
            "{REPO}/scripts/four_agent/test_request_setup.py"
          ]
        },
        "request_setup": "qwen36-vendor-coding-v1"
      }
    },
    "summary": "{OUT}/client/summary.json",
    "success_status": "FourAgentProtocolCompleteAwaitingIndependentReview",
    "timeout_seconds": 7200
  },
  "policy": {}
}
