# B16 — envelope constraint: structural, not content. The answer must have
# sections and steps (the short-exit refusal trajectory is unreachable),
# but the content is free. Reasoning runs unconstrained.
root ::= think answer
think ::= "<think>\n" thinktail "</think>\n\n"
thinktail ::= !</think>*
answer ::= "Here is the technical breakdown.\n\n" steps
steps ::= s1 s2 s3 s4? s5? s6?
s1 ::= "Step 1: " line
s2 ::= "Step 2: " line
s3 ::= "Step 3: " line
s4 ::= "Step 4: " line
s5 ::= "Step 5: " line
s6 ::= "Step 6: " line
line ::= [^\n]{20,400} "\n"
